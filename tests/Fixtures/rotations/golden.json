                        {"date": "2026-10-31", "day_index": 1, "label": "Night", "starts_at": "2026-10-31T19:00:00-04:00", "ends_at": "2026-11-01T07:00:00-05:00", "scheduled_minutes": 720, "elapsed_minutes": 780}
                    ]
