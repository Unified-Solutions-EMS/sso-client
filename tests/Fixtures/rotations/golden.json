                        {"date": "2026-06-02", "day_index": 0, "label": "Day car", "starts_at": "2026-06-02T05:00:00-05:00", "ends_at": "2026-06-02T17:00:00-05:00", "scheduled_minutes": 720, "elapsed_minutes": 720}
