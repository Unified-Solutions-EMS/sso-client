{
    "about": "Golden cases for RotationCalendar::windows (SSO app/Support/Rotations/RotationCalendar.php; sso-client copies the expander and runs these too). Each case is one rotation, a timezone and a local date range (inclusive); each assignment lists every on-duty window that overlaps the range, including a block that started the day before. Cycle day = (date - anchor_date + start_day_index) mod cycle_days. Ends are start wall clock + duration as wall clock (decision D6), so elapsed_minutes differs from scheduled_minutes on daylight-saving nights.",
    "cases": [
        {
            "name": "24 on / 48 off, three platoons on one rotation (start days 0, 1, 2)",
            "timezone": "America/New_York",
            "rotation": {"cycle_days": 3, "anchor_date": "2026-01-05", "blocks": [{"day_index": 0, "start_time": "07:00", "duration_minutes": 1440, "label": null}]},
            "from": "2026-01-05",
            "to": "2026-01-07",
            "assignments": [
                {
                    "assignment": {"start_day_index": 0, "starts_on": null, "ends_on": null},
                    "expected": [
                        {"date": "2026-01-05", "day_index": 0, "label": null, "starts_at": "2026-01-05T07:00:00-05:00", "ends_at": "2026-01-06T07:00:00-05:00", "scheduled_minutes": 1440, "elapsed_minutes": 1440}
                    ]
                },
                {
                    "assignment": {"start_day_index": 1, "starts_on": null, "ends_on": null},
                    "expected": [
                        {"date": "2026-01-04", "day_index": 0, "label": null, "starts_at": "2026-01-04T07:00:00-05:00", "ends_at": "2026-01-05T07:00:00-05:00", "scheduled_minutes": 1440, "elapsed_minutes": 1440},
                        {"date": "2026-01-07", "day_index": 0, "label": null, "starts_at": "2026-01-07T07:00:00-05:00", "ends_at": "2026-01-08T07:00:00-05:00", "scheduled_minutes": 1440, "elapsed_minutes": 1440}
                    ]
                },
                {
                    "assignment": {"start_day_index": 2, "starts_on": null, "ends_on": null},
                    "expected": [
                        {"date": "2026-01-06", "day_index": 0, "label": null, "starts_at": "2026-01-06T07:00:00-05:00", "ends_at": "2026-01-07T07:00:00-05:00", "scheduled_minutes": 1440, "elapsed_minutes": 1440}
                    ]
                }
            ]
        },
        {
            "name": "Kelly: 24 on, 24 off, 24 on, 24 off, 24 on, 96 off (9-day cycle)",
            "timezone": "America/New_York",
            "rotation": {"cycle_days": 9, "anchor_date": "2026-02-02", "blocks": [
                {"day_index": 0, "start_time": "08:00", "duration_minutes": 1440, "label": null},
                {"day_index": 2, "start_time": "08:00", "duration_minutes": 1440, "label": null},
                {"day_index": 4, "start_time": "08:00", "duration_minutes": 1440, "label": null}
            ]},
            "from": "2026-02-02",
            "to": "2026-02-11",
            "assignments": [
                {
                    "assignment": {"start_day_index": 0, "starts_on": null, "ends_on": null},
                    "expected": [
                        {"date": "2026-02-02", "day_index": 0, "label": null, "starts_at": "2026-02-02T08:00:00-05:00", "ends_at": "2026-02-03T08:00:00-05:00", "scheduled_minutes": 1440, "elapsed_minutes": 1440},
                        {"date": "2026-02-04", "day_index": 2, "label": null, "starts_at": "2026-02-04T08:00:00-05:00", "ends_at": "2026-02-05T08:00:00-05:00", "scheduled_minutes": 1440, "elapsed_minutes": 1440},
                        {"date": "2026-02-06", "day_index": 4, "label": null, "starts_at": "2026-02-06T08:00:00-05:00", "ends_at": "2026-02-07T08:00:00-05:00", "scheduled_minutes": 1440, "elapsed_minutes": 1440},
                        {"date": "2026-02-11", "day_index": 0, "label": null, "starts_at": "2026-02-11T08:00:00-05:00", "ends_at": "2026-02-12T08:00:00-05:00", "scheduled_minutes": 1440, "elapsed_minutes": 1440}
                    ]
                }
            ]
        },
        {
            "name": "Every day 05:00 to 17:00 (one-day cycle), with and without a start date",
            "timezone": "America/Chicago",
            "rotation": {"cycle_days": 1, "anchor_date": "2026-06-01", "blocks": [{"day_index": 0, "start_time": "05:00", "duration_minutes": 720, "label": "Day car"}]},
            "from": "2026-06-01",
            "to": "2026-06-02",
