                    ]
                }
            ]
        },
        {
            "name": "A night block crossing midnight runs into the next day; ends_on stops new blocks",
            "timezone": "America/New_York",
            "rotation": {"cycle_days": 2, "anchor_date": "2026-04-01", "blocks": [{"day_index": 1, "start_time": "19:00", "duration_minutes": 720, "label": "Night"}]},
            "from": "2026-04-03",
            "to": "2026-04-03",
            "assignments": [
                {
                    "assignment": {"start_day_index": 0, "starts_on": null, "ends_on": null},
                    "expected": [
                        {"date": "2026-04-02", "day_index": 1, "label": "Night", "starts_at": "2026-04-02T19:00:00-04:00", "ends_at": "2026-04-03T07:00:00-04:00", "scheduled_minutes": 720, "elapsed_minutes": 720}
                    ]
                },
                {
                    "assignment": {"start_day_index": 0, "starts_on": null, "ends_on": "2026-04-01"},
                    "expected": []
                }
            ]
        },
        {
