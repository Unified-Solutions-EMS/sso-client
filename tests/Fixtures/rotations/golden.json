                        {"date": "2026-11-01", "day_index": 1, "label": "Night", "starts_at": "2026-11-01T19:00:00-05:00", "ends_at": "2026-11-02T07:00:00-05:00", "scheduled_minutes": 720, "elapsed_minutes": 720}
